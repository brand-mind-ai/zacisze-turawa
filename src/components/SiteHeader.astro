---
import UtilityIcon from "@components/UtilityIcon.astro";
import { primaryNavigation, socialLinks } from "@lib/site-navigation";
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Hotel Zacisze">
    <img src="/media/brand/zacisze-logo-ogg.svg" alt="Hotel Zacisze" width="210" height="66" />
  </a>

  <nav class="primary-nav" aria-label="Główna nawigacja">
    {primaryNavigation.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>

  <div class="header-actions" aria-label="Linki kontaktowe">
    {socialLinks.map((item) => (
      <a
        class:list={["utility-link", `utility-link-${item.kind}`]}
        href={item.href}
        aria-label={item.label}
        title={item.label}
        target={item.href.startsWith("http") ? "_blank" : undefined}
        rel={item.href.startsWith("http") ? "noreferrer" : undefined}
      >
        <UtilityIcon kind={item.kind} />
        {item.kind === "phone" && <span>{item.label}</span>}
      </a>
    ))}
    <a class="booking-link" href="/ceny_i_rezerwacja">Rezerwuj</a>
  </div>
</header>
