  )
}
{
  kind === "map" && (
    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" />
      <circle class="icon-cutout" cx="12" cy="10" r="2.2" />
