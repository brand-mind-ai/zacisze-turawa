    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <rect x="4" y="4" width="16" height="16" rx="4.2" ry="4.2" />
      <circle cx="12" cy="12" r="3.4" />
      <circle cx="16.8" cy="7.2" r="1" />
    </svg>
  )
}
{
