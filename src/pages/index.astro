---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";

import ContentPage from "@components/ContentPage.astro";

const pages = await getCollection("plPages");
const rooms = await getCollection("plRooms");
const offers = await getCollection("plOffers");
const page = pages.find((entry) => entry.data.canonicalPath === "/");

if (!page) {
  throw new Error("Missing Polish homepage content.");
}

const { Content } = await render(page);
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description}>
  <ContentPage page={page} Content={Content} rooms={rooms} offers={offers} />
</BaseLayout>
