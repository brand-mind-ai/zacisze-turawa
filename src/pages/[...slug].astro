---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ContentPage from "@components/ContentPage.astro";

export async function getStaticPaths() {
  const entries = [
    ...(await getCollection("plPages")),
    ...(await getCollection("plRooms")),
    ...(await getCollection("plOffers")),
  ].filter((entry) => entry.data.canonicalPath !== "/" && entry.data.canonicalPath !== "/strefa_spa");

  return entries.map((entry) => ({
    params: { slug: entry.data.canonicalPath.replace(/^\//, "") },
    props: { page: entry },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description}>
  <ContentPage page={page} Content={Content} />
</BaseLayout>
