---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Zacisze Turawa website rebuild.",
  noindex = import.meta.env.PUBLIC_DEPLOY_STAGE !== "production",
} = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-paper: #f6f1ea;
    --color-ink: #131210;
    --color-white: #fafafa;
    --color-line: #cdc0b1;
    --color-brown: #231c1a;
    --color-olive: #3c3121;
    --font-sans: "Host Grotesk", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --font-serif: "Libre Baskerville", Georgia, serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: minmax(9rem, 13rem) 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding: 0.85rem clamp(1rem, 3vw, 2.5rem);
    color: var(--color-white);
    background: linear-gradient(to bottom, rgba(19, 18, 16, 0.44), rgba(19, 18, 16, 0));
  }

  .site-logo img {
    width: min(13rem, 42vw);
    height: auto;
  }

  .site-nav,
  .site-actions,
  .footer-social {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .site-nav {
    justify-content: center;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-actions a {
    display: inline-grid;
    place-items: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 0.45rem;
    border: 1px solid rgba(250, 250, 250, 0.48);
    border-radius: 999px;
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .page-hero {
    position: relative;
    min-height: clamp(29rem, 76svh, 48rem);
    background: var(--color-brown);
    overflow: clip;
  }

  .page-hero > img {
    width: 100%;
    height: 100%;
    min-height: clamp(29rem, 76svh, 48rem);
    object-fit: cover;
  }

  .booking-bar {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3vw, 2rem);
    transform: translateX(-50%);
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(8rem, 1fr)) auto;
    align-items: end;
    gap: 0.65rem;
    width: min(58rem, calc(100% - 2rem));
    padding: 0.75rem;
    background: color-mix(in srgb, var(--color-paper) 94%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-white) 54%, transparent);
    border-radius: 0;
    box-shadow: 0 1.25rem 4rem rgba(19, 18, 16, 0.22);
    backdrop-filter: blur(18px);
  }

  .booking-bar label {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .booking-bar span {
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .booking-bar input,
  .booking-bar button {
    width: 100%;
    min-height: 2.6rem;
    border: 1px solid var(--color-line);
    background: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .booking-bar input {
    padding: 0 0.65rem;
  }

  .booking-bar button {
    padding: 0 1.15rem;
    background: var(--color-brown);
    color: var(--color-white);
    border-color: var(--color-brown);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .content-section {
    width: min(58rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 0;
    overflow-wrap: break-word;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-olive);
    font-size: 0.73rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
    font-weight: 400;
    letter-spacing: 0;
  }

  h1 {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(1.75rem, 3.2vw, 3.1rem);
    line-height: 1.12;
  }

  .lead {
    max-width: 48rem;
    margin: 1.4rem 0 0;
    font-size: clamp(1.02rem, 1.5vw, 1.2rem);
    line-height: 1.75;
  }

  .markdown-body {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.78;
  }

  .markdown-body :where(p, ul, ol) {
    max-width: 46rem;
  }

  .markdown-body h2 {
    margin-top: 2.5rem;
    font-size: clamp(1.35rem, 2.3vw, 2rem);
  }

  .booking-frame-section,
  .related-section,
  .media-gallery,
  .site-footer {
    width: min(76rem, calc(100% - 2rem));
    margin: 0 auto;
  }

  .booking-frame-section {
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .booking-frame-section iframe {
    width: 100%;
    min-height: 78svh;
    border: 1px solid var(--color-line);
    background: var(--color-white);
  }

  .related-section {
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .section-heading h2 {
    margin: 0 0 1.2rem;
    font-size: clamp(1.45rem, 2.4vw, 2.3rem);
  }

  .related-scroller {
    display: grid;
    grid-auto-columns: minmax(16rem, 23rem);
    grid-auto-flow: column;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding-bottom: 1rem;
    scroll-snap-type: inline mandatory;
  }

  .related-card {
    display: grid;
    grid-template-rows: 14rem auto;
    min-width: 0;
    background: var(--color-white);
    border: 1px solid color-mix(in srgb, var(--color-line) 76%, transparent);
    scroll-snap-align: start;
  }

  .related-card img {
    width: 100%;
    height: 14rem;
    object-fit: cover;
  }

  .related-card span {
    padding: 1rem;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .media-gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    padding: clamp(2rem, 5vw, 4rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .media-gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .site-footer {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 2rem;
    padding: clamp(2.5rem, 6vw, 4.5rem) 0;
    border-top: 1px solid var(--color-line);
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 1.45rem;
  }

  .site-footer nav,
  .footer-social {
    align-items: flex-start;
    flex-direction: column;
  }

  @media (max-width: 820px) {
    .site-header {
      grid-template-columns: 1fr;
      justify-items: center;
      position: relative;
      color: var(--color-ink);
      background: var(--color-paper);
    }

    .site-logo img {
      filter: invert(22%) sepia(16%) saturate(1120%) hue-rotate(341deg) brightness(88%) contrast(88%);
    }

    .site-nav,
    .site-actions {
      justify-content: center;
    }

    .site-nav {
      display: grid;
      grid-template-columns: repeat(3, auto);
      width: 100%;
      max-width: 100%;
      overflow: visible;
      justify-content: center;
      gap: 0.55rem 0.85rem;
      padding-bottom: 0.25rem;
      font-size: 0.72rem;
      white-space: normal;
    }

    .site-actions a {
      border-color: color-mix(in srgb, var(--color-line) 74%, transparent);
    }

    .page-hero,
    .page-hero > img {
      min-height: 28rem;
    }

    .booking-bar {
      grid-template-columns: 1fr;
      left: 0.5rem;
      bottom: 1rem;
      width: calc(100% - 1rem);
      transform: none;
    }

    .booking-bar button {
      grid-column: 1 / -1;
    }

    h1 {
      font-size: clamp(1.55rem, 7vw, 2.15rem);
    }

    .media-gallery,
    .site-footer {
      grid-template-columns: 1fr;
    }
  }
</style>
